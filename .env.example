# Copy to .env and fill in. .env is git-ignored — never commit a real token.
#
# Sentinel API write token. With this UNSET, the write endpoints (POST /api/alerts,
# POST /api/ingest) refuse traffic with HTTP 503 rather than falling open. Reads
# (dashboard, /api/alerts, /health, /ws/alerts) stay unauthenticated by design.
#
# Generate one with:
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
#
# Clients then send it as:
#   Authorization: Bearer <token>
SENTINEL_API_TOKEN=
